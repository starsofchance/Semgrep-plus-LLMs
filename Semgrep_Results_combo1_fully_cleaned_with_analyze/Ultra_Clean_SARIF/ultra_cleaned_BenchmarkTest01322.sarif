            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "BenchmarkTest01322.java"
                },
                "snippet": {
                  "text": "            javax.crypto.Cipher c = javax.crypto.Cipher.getInstance(\"DES/CBC/PKCS5Padding\");"
                }
              }
            }
