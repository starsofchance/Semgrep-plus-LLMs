          "fingerprints": {
            "matchBasedId/v1": "f843a07d724e509b9f31222a43292135965588be117bbd1cd404a496068b923ef616ec5684c45644c45201072d26611cc166cce2a02eacfdd86b90a1a3a03d20_0"
