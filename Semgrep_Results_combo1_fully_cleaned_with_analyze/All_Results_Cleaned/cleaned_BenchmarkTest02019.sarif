                  "endColumn": 98,
                  "endLine": 50,
                  "snippet": {
                    "text": "                    javax.crypto.Cipher.getInstance(\n                            \"DES/CBC/PKCS5PADDING\", java.security.Security.getProvider(\"SunJCE\"));"
                  },
                  "startColumn": 21,
                  "startLine": 49
                }
